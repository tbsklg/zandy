@startuml architecture
title zandy — component overview

skinparam shadowing false

package "src" {
  [main] as main
  [cli] as cli
  [preset] as preset
  [env] as env
  [config] as config
  [profile] as profile
  [launch] as launch
  [sbpl] as sbpl
  [macos] as macos
  [broker] as broker
  [rpc] as rpc
  [registry] as registry
  [command] as command
  [client] as client
}

database "profiles/*.zon" as zon
database "adapters/*.zon" as adapters
component "libsandbox" as sandbox
component "adapter binary\n(e.g. glab)" as tool

main --> cli : parse args
main --> preset : find preset
main --> env : env init
main --> config : load config
main --> profile : build profile
main --> launch : launch

preset --> sbpl
preset ..> zon : comptime @import

profile --> sbpl
profile --> env
profile --> config

launch --> sbpl : serialize
launch --> env
launch --> macos
launch --> registry : parseAdapters
launch --> broker : listen / serveLoop

registry ..> adapters : comptime @import
registry --> command : parseTemplate

broker --> rpc : handle
rpc --> registry : discover / find
rpc --> command : parseParams / run
command --> tool : spawn

client --> broker : Unix socket\n(BROKER_SOCK, BROKER_TICKET)

macos --> sandbox : sandbox_init_with_parameters

@enduml
