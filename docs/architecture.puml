@startuml architecture
title zandy — component overview

skinparam shadowing false

package "Nix (nix/, flake.nix)" {
  [lib.mkSandboxEnv] as mk
  [presets/*.nix] as presets
  [adapters/*.nix] as nixadapters
  [zandy package] as pkg
}

package "sandbox env (/nix/store/…-<name>)" {
  artifact "bin/zandy-<name>\n(launcher)" as launcher
  artifact "sandbox/bin\n(sandbox PATH)" as sbin
  artifact "store-paths\n(exec allowlist)" as storepaths
  artifact "zandy.json\n(manifest)" as manifestjson
}

package "src" {
  [main] as main
  [cli] as cli
  [sandbox_env] as senv
  [store] as store
  [manifest] as manifest
  [env] as env
  [profile] as profile
  [launch] as launch
  [sbpl] as sbpl
  [macos] as macos
  [broker] as broker
  [rpc] as rpc
  [registry] as registry
  [command] as command
  [client] as client
}

component "libsandbox" as sandbox
component "adapter binary\n(/nix/store/…/bin/glab)" as tool

mk --> presets
mk --> nixadapters
mk --> pkg
mk --> launcher
mk --> sbin : buildEnv
mk --> storepaths : closureInfo
mk --> manifestjson : toJSON

launcher --> main : zandy --env <env>

main --> cli : parse args
main --> senv : load(--env)
main --> env : env init
main --> profile : build profile
main --> launch : launch

senv --> store : parse root, store-paths
senv --> manifest : parse zandy.json
senv ..> storepaths
senv ..> manifestjson

manifest --> sbpl
manifest --> registry

profile --> sbpl
profile --> store : exec/read rules
profile --> env

launch --> sbpl : serialize
launch --> env
launch --> macos
launch --> registry : parseAdapters
launch --> broker : listen / serveLoop
launch ..> sbin : PATH, binary

registry --> command : parseTemplate

broker --> rpc : handle
rpc --> registry : discover / find
rpc --> command : parseParams / run
command --> tool : spawn

client --> broker : Unix socket\n(BROKER_SOCK, BROKER_TICKET)

macos --> sandbox : sandbox_init_with_parameters

@enduml
