@startuml overview
title zandy — overview

skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

rectangle "build time" {
  file "flake.nix" as Flake
  component "Nix\ndescribes the sandbox" as Nix
  artifact "sandbox env\n(tools, manifest, no secrets)" as SEnv
}

rectangle "run time" {
  component "Zig\nbuilds the profile, starts the gateway, runs the broker" as Zig

  rectangle "Seatbelt sandbox" #EEF {
    component "agent" as Agent
  }

  rectangle "outside" {
    component "broker" as Broker
    component "external tools\n(credentials)" as Tools
    component "gateway\n(proxy with the model key)" as Gateway
  }

  cloud "model backend" as Model
}

Flake --> Nix
Nix --> SEnv
SEnv --> Zig
Zig --> Agent : profile
Zig --> Broker
Agent --> Broker : request
Broker --> Tools : runs
Zig --> Gateway : starts
Agent --> Gateway : HTTP
Gateway --> Model : HTTPS + auth
@enduml
