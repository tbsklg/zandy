@startuml runtime-flow
title zandy — runtime flow

skinparam shadowing false

actor "user" as User
participant "launcher\nbin/zandy-<name>" as Launcher
participant "main" as Main
participant "cli" as Cli
participant "SandboxEnv" as SEnv
participant "env" as Env
participant "profile" as Profile
participant "launch" as Launch
participant "registry" as Registry
participant "broker / rpc" as Broker
participant "macos / libsandbox" as Sandbox
participant "preset binary\nsandbox/bin/<binary>" as Bin
participant "zandy-client" as Client
participant "adapter binary\n/nix/store/…" as Tool
participant "gateway proxy\ncaddy / aws-sigv4-proxy" as Gateway

User -> Launcher : zandy-claude [args]  (or nix run)
Launcher -> Main : exec zandy --env <env> [args]
Main -> Cli : parseArgs(argv)
Cli --> Main : Launch (env, args)

Main -> SEnv : load(env)
SEnv -> SEnv : realpath → StorePath
SEnv -> SEnv : parse store-paths → closure (+ env itself)
SEnv -> SEnv : parse zandy.json → Manifest
SEnv -> SEnv : no adapter binary in closure
SEnv --> Main : SandboxEnv

Main -> Env : Env.init(envMap)
Env --> Main : Env (home, cwd, tmpdir)
Main -> Profile : buildProfile(preset.profile, env, filesystem, closure)
Profile --> Main : sbpl.Profile (preset rules + exec/read per store path + filesystem)

Main -> Launch : launch(init, sandbox_env, args, profile, env)
Launch -> Gateway : start(argv, env + ZANDY_GATEWAY_PORT), wait until listening
Launch -> Launch : serialize(profile + allow localhost:<gateway port>) → SBPL text
Launch -> Broker : listen(BROKER_SOCK)
Launch -> Launch : sandbox Environ.Map (preset env names + PATH, SHELL, BROKER_SOCK, BROKER_TICKET, gatewayEnv with {url})
Launch -> Registry : parseAdapters(manifest.adapters)
Registry --> Launch : []Capability

Launch -> Launch : fork()

group child process
  Launch -> Sandbox : sandbox_init_with_parameters(sbpl, CWD, HOME, TMPDIR, BROKER_SOCK)
  Sandbox --> Launch : rc == 0
  Launch -> Bin : execve(sandbox/bin/<binary>, preset args + args, sandbox envp)
end

group parent process
  Launch -> Broker : serveLoop (thread)
  Launch -> Launch : waitpid(child)
  Launch -> Gateway : stop
end

group model request
  Bin -> Gateway : HTTP to {url}
  Gateway -> Gateway : add credentials, forward to the fixed upstream
  Gateway --> Bin : streamed response
end

group broker call
  Bin -> Client : zandy-client call <method> '<json args>'
  Client -> Broker : JSON-RPC {method, params: {ticket, args}}
  Broker -> Broker : check ticket, find (policy), parseParams, buildArgv
  Broker -> Tool : spawn by store path (PATH, HOME, adapter env)
  Tool --> Broker : exit code, stdout, stderr
  Broker --> Client : result = stdout | error = stderr
  Client --> Bin : stdout
end

@enduml
